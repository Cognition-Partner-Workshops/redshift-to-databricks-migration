          "customer_id"
        ],
        "target": "customer_id"
      },
      "fields": [
        {
          "source": "customer_id",
          "target": "customer_id",
          "source_type": "INTEGER",
          "target_type": "INT"
        },
        {
          "source": "customer_code",
          "target": "customer_code",
          "source_type": "CHAR(12)",
          "target_type": "STRING",
          "rules": [
            "rstrip_spaces"
          ]
        },
        {
          "source": "region",
          "target": "region",
          "source_type": "CHAR(4)",
          "target_type": "STRING",
          "rules": [
