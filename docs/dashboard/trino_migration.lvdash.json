{
  "datasets": [
    {
      "name": "ds_order_kpis",
      "displayName": "Order KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS orders, SUM(order_total) AS gross_revenue ",
        "FROM trino_migration_demo.core.orders ",
        "WHERE order_status <> 'CANCELLED'"
      ]
    },
    {
      "name": "ds_ltv_kpis",
      "displayName": "Customer LTV KPIs",
      "queryLines": [
        "SELECT COUNT(*) AS active_customers, AVG(lifetime_revenue) AS avg_ltv ",
        "FROM customer_ltv"
      ]
    },
    {
      "name": "ds_daily_revenue",
      "displayName": "Daily Revenue",
      "queryLines": [
        "SELECT CAST(order_date AS DATE) AS order_date, promo_group, gross_revenue ",
        "FROM daily_revenue ",
        "ORDER BY order_date, promo_group"
      ]
    },
    {
      "name": "ds_region_revenue",
      "displayName": "Revenue by Region",
      "queryLines": [
        "SELECT region, lifetime_revenue ",
        "FROM customer_ltv ",
        "ORDER BY lifetime_revenue DESC"
      ]
    },
    {
      "name": "ds_promo_aov",
      "displayName": "Average Order Value by Promo",
      "queryLines": [
        "SELECT element_at(attrs, 'promo') AS promo, order_total ",
        "FROM trino_migration_demo.core.orders ",
        "WHERE order_status <> 'CANCELLED' ",
        "ORDER BY promo"
      ]
    },
    {
      "name": "ds_reconciliation",
      "displayName": "Trino Snapshot vs Databricks",
      "queryLines": [
        "SELECT object, metric, trino, databricks, IF(trino = databricks, 'MATCH', 'MISMATCH') AS status ",
        "FROM ( ",
        "SELECT 'mart.daily_revenue' AS object, 'rows' AS metric, ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.trino_src.mart_daily_revenue) AS trino, ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.mart.daily_revenue) AS databricks ",
        "UNION ALL SELECT 'mart.daily_revenue','sum gross_revenue', ",
        "       (SELECT SUM(gross_revenue) FROM trino_migration_demo.trino_src.mart_daily_revenue), ",
        "       (SELECT SUM(gross_revenue) FROM trino_migration_demo.mart.daily_revenue) ",
        "UNION ALL SELECT 'mart.daily_revenue','sum order_count', ",
        "       (SELECT SUM(order_count) FROM trino_migration_demo.trino_src.mart_daily_revenue), ",
        "       (SELECT SUM(order_count) FROM trino_migration_demo.mart.daily_revenue) ",
        "UNION ALL SELECT 'mart.customer_ltv','rows', ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.trino_src.mart_customer_ltv), ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.mart.customer_ltv) ",
        "UNION ALL SELECT 'mart.customer_ltv','sum lifetime_revenue', ",
        "       (SELECT SUM(lifetime_revenue) FROM trino_migration_demo.trino_src.mart_customer_ltv), ",
        "       (SELECT SUM(lifetime_revenue) FROM trino_migration_demo.mart.customer_ltv) ",
        "UNION ALL SELECT 'mart.customer_ltv','sum active_days', ",
        "       (SELECT SUM(active_days) FROM trino_migration_demo.trino_src.mart_customer_ltv), ",
        "       (SELECT SUM(active_days) FROM trino_migration_demo.mart.customer_ltv) ",
        "UNION ALL SELECT 'core.orders','rows', ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.trino_src.core_orders), ",
        "       (SELECT COUNT(*) FROM trino_migration_demo.core.orders) ",
        ") reconciliation"
      ]
    }
  ],
